; DuoSound installer — build with: iscc packaging\duosound_installer.iss
; Requires: Inno Setup 6+  (https://jrsoftware.org/isinfo.php)
; Both DuoSound.exe (Flet) and DuoSound_Lite.exe (tkinter) must exist in dist\ before running this.

#define MyAppName      "DuoSound"
#define MyAppVersion   "0.1.1"
#define MyAppPublisher "Amon Lal"
#define MyAppURL       "https://github.com/AmonHooriLal/duosound"
#define MyAppExeFull   "DuoSound.exe"
#define MyAppExeLite   "DuoSound_Lite.exe"

[Setup]
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
; Zero setup is the product's first priority: never prompt for admin. With "lowest",
; {autopf} resolves to %LOCALAPPDATA%\Programs and every {auto*} constant follows suit,
; so DuoSound installs for the current user even on a locked-down work laptop.
PrivilegesRequired=lowest
AllowNoIcons=yes
OutputDir=..\dist
OutputBaseFilename=DuoSound_Setup
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
DisableProgramGroupPage=yes
CloseApplications=yes
; Inno Setup 6+ hides the Welcome page by default, which makes Setup look like it has no wizard
; at all. Turn it back on so the first thing a user sees is the branded welcome.
DisableWelcomePage=no
AppCopyright=Created by {#MyAppPublisher}
; Generated by packaging/make_icon.py on every build.
WizardImageFile=wizard_banner.bmp
WizardSmallImageFile=wizard_small.bmp
VersionInfoVersion={#MyAppVersion}
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription=DuoSound - one movie, many headphones, in sync
VersionInfoCopyright=Copyright (C) 2026 {#MyAppPublisher}

; Each type preselects one component. "iscustom" marks the single free-pick type, so at most one
; entry may carry it (Inno Setup 7 errors on a second); these two only preselect, so neither does.
[Types]
Name: "full";  Description: "Full Graphics (Flet) — recommended for modern PCs"
Name: "lite";  Description: "Classic Graphics — recommended for older PCs or battery use"

[Components]
Name: "full";  Description: "Full Graphics (animated glass UI, requires ~90 MB)";  Types: full;  Flags: exclusive
Name: "lite";  Description: "Classic Graphics (lightweight tkinter UI, ~35 MB)";   Types: lite;  Flags: exclusive

[Files]
; Both executables are always installed — the user can switch later by running the other .exe
Source: "..\dist\{#MyAppExeFull}";   DestDir: "{app}";  Flags: ignoreversion
Source: "..\dist\{#MyAppExeLite}";   DestDir: "{app}";  Flags: ignoreversion

[Icons]
; Full-graphics shortcut — created only when Full component is selected
Name: "{group}\{#MyAppName}";           Filename: "{app}\{#MyAppExeFull}";   Components: full
Name: "{autodesktop}\{#MyAppName}";   Filename: "{app}\{#MyAppExeFull}";   Components: full;  Tasks: desktopicon

; Lite shortcut — created only when Lite component is selected
Name: "{group}\{#MyAppName} (Lite)";           Filename: "{app}\{#MyAppExeLite}";   Components: lite
Name: "{autodesktop}\{#MyAppName} (Lite)";   Filename: "{app}\{#MyAppExeLite}";   Components: lite;  Tasks: desktopicon

; "Escape hatch" shortcut: always install both exe shortcuts in the install folder for easy switching
Name: "{group}\{#MyAppName} Full Graphics";     Filename: "{app}\{#MyAppExeFull}"
Name: "{group}\{#MyAppName} Classic Graphics";  Filename: "{app}\{#MyAppExeLite}"
Name: "{group}\Uninstall {#MyAppName}";         Filename: "{uninstallexe}"

[Tasks]
Name: "desktopicon";  Description: "Create a Desktop shortcut";  GroupDescription: "Additional icons:"

; Wizard wording. The author credit appears on the first and last page, so it is seen whichever
; edition (Full Graphics or Classic Graphics) the user picks.
[Messages]
WelcomeLabel1=Welcome to [name]
WelcomeLabel2=One movie, many headphones, in sync.%n%nCreated by {#MyAppPublisher}.%n%nSetup will install [name/ver] on your computer. On the next page you can choose Full Graphics or Classic Graphics — both are installed either way, so you can switch whenever you like.
FinishedHeadingLabel=[name] is ready
FinishedLabel=Setup has finished installing [name] on your computer.%n%nCreated by {#MyAppPublisher}.%n%nConnect your headphones in Windows Bluetooth settings, then press Start.
FinishedLabelNoIcons=Setup has finished installing [name] on your computer.%n%nCreated by {#MyAppPublisher}.

[Run]
Filename: "{app}\{code:GetMainExe}";  Description: "Launch {#MyAppName} now";  Flags: nowait postinstall skipifsilent

[Code]
function GetMainExe(Param: String): String;
begin
  if WizardIsComponentSelected('full') then
    Result := ExpandConstant('{app}\{#MyAppExeFull}')
  else
    Result := ExpandConstant('{app}\{#MyAppExeLite}');
end;
