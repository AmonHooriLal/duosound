# Build output
dist/
build/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Test runner cache
.pytest_cache/

# Flet client cache (fetched by fetch_flet_client.py; large binary, not committed)
packaging/flet_client/

# Generated build artifacts (regenerated by make_icon.py during build)
packaging/duosound.ico
packaging/version_info.txt
packaging/wizard_banner.bmp
packaging/wizard_small.bmp

# Environment / secrets
.env

# Local notes / scratch
*.local.md
scratch/

# Logs (generated at runtime; not part of source)
logs/

# Runtime state. These normally live in %APPDATA%\DuoSound\, never in the repo, but a stray copy
# here would leak the developer's own device list and volume levels into a public release.
settings.json
restore.json
duosound_test_*/

# --- Do NOT ignore ---
# packaging/*.spec   (PyInstaller specs are source files)
# packaging/*.iss    (Inno Setup scripts are source files)
# packaging/make_icon.py
# packaging/fetch_flet_client.py
# packaging/rthook_flet.py
